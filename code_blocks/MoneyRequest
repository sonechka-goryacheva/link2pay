vector<string> extractUsernames(const string& text) {
    vector<string> usernames;
    size_t pos = 0;
    while (pos < text.length()) {
        pos = text.find('@', pos);
        if (pos == string::npos) break;

        size_t end = text.find_first_of(" ,.!?\n", pos + 1);
        if (end == string::npos) end = text.length();

        string username = text.substr(pos, end - pos);
        if (!username.empty()) {
            usernames.push_back(username);
        }
        pos = end;
    }
    return usernames;
}

int main() {
    Bot bot("BOT_TOKEN");

    map<int64_t, UserData> users;

    bot.getEvents().onCommand("start", [&bot, &users](Message::Ptr message) {
        if (message) {
            if (!isRegistered(message->chat->id)) {
                auto keyboard = make_shared<ReplyKeyboardMarkup>();
                KeyboardButton::Ptr button(new KeyboardButton);
                button->text = "Отправить данные";
                button->requestContact = true;
                vector<KeyboardButton::Ptr> row = { button };
                keyboard->keyboard.push_back(row);
                bot.getApi().sendMessage(
                    message->chat->id,
                    "Добро пожаловать в Link2Pay!\n\nЧтобы продолжить, необходимо дать "
                    "согласие на обработку персональных данных.",
                    nullptr, 0, keyboard);
            } else {
                print_functions(bot, message);
            }
        }
    });

    bot.getEvents().onCallbackQuery([&bot, &users](CallbackQuery::Ptr query) {
        int64_t chatId = query->message->chat->id;

        if (query->data == "request_money") {
            requestMoneyDataMap[chatId] = RequestMoneyData();
            requestMoneyDataMap[chatId].setState(RequestMoneyData::WaitingForRecipient);
            bot.getApi().sendMessage(chatId, "Введите тэг плательщика/ов (например, @username):");
            bot.getApi().deleteMessage(query->message->chat->id, query->message->messageId);
        }
        else if (query->data == "no_message") {
            if (requestMoneyDataMap.find(chatId) != requestMoneyDataMap.end() &&
                requestMoneyDataMap[chatId].getState() == RequestMoneyData::WaitingForMessage) {
                requestMoneyDataMap[chatId].setMessage("");
                requestMoneyDataMap[chatId].setState(RequestMoneyData::WaitingForConfirmation);

                string confirmationText = "Проверьте данные:\n\n" +
                    string("Плательщик: ") + requestMoneyDataMap[chatId].getPayer() + "\n" +
                    "Сумма: " + requestMoneyDataMap[chatId].getAmount();

                auto confirmKeyboard = make_shared<InlineKeyboardMarkup>();
                InlineKeyboardButton::Ptr confirmBtn(new InlineKeyboardButton);
                confirmBtn->text = "Подтвердить";
                confirmBtn->callbackData = "confirm_send";
                InlineKeyboardButton::Ptr changeBtn(new InlineKeyboardButton);
                changeBtn->text = "Изменить";
                changeBtn->callbackData = "change_send";
                confirmKeyboard->inlineKeyboard.push_back({ confirmBtn, changeBtn });

                bot.getApi().sendMessage(chatId, confirmationText, nullptr, 0, confirmKeyboard);
                bot.getApi().deleteMessage(query->message->chat->id, query->message->messageId);
            }
        }
        else if (query->data == "confirm_send") {
            if (requestMoneyDataMap.find(chatId) != requestMoneyDataMap.end()) {
                RequestMoneyData &data = requestMoneyDataMap[chatId];
                vector<string> payers;
                string responseMessage;

                // Извлекаем всех упомянутых пользователей из сообщения
                size_t pos = 0;
                while ((pos = data.getPayer().find('@', pos)) != string::npos) {
                    size_t end = data.getPayer().find_first_of(" ,", pos);
                    if (end == string::npos) end = data.getPayer().length();
                    string username = data.getPayer().substr(pos, end - pos);
                    if (!username.empty()) {
                        payers.push_back(username);
                    }
                    pos = end;
                }

                if (payers.empty()) {
                    // Обработка одиночного получателя (старая логика)
                    if (tg_id.find(data.getPayer()) != tg_id.end()) {
                        int64_t payerChatId = tg_id[data.getPayer()].getChatId();
                        string payerMsg = "Вам поступил запрос на перевод от @" +
                                            query->message->chat->username + ":\n" +
                                            "Сумма: " + data.getAmount() + "\n";

                        if (!data.getMessage().empty()) {
                            payerMsg += "Сообщение: " + data.getMessage() + "\n";
                        }

                        try {
                            bot.getApi().sendMessage(payerChatId, payerMsg);
                            responseMessage = "Запрос на перевод отправлен пользователю " + data.getPayer();
                        } catch (const exception& e) {
                            responseMessage = "Ошибка при отправке запроса: " + string(e.what());
                        }
                    } else {
                        responseMessage = "Пользователь " + data.getPayer() + " не найден в системе.";
                    }
                } else {
                    // Обработка нескольких получателей
                    vector<string> successPayers;
                    vector<string> failedPayers;
                    vector<string> noInteractionPayers;

                    for (const string& payer : payers) {
                        if (tg_id.find(payer) != tg_id.end()) {
                            int64_t payerChatId = tg_id[payer].getChatId();

                            if (requestMoneyDataMap.find(chatId) !=requestMoneyDataMap.end()) {
                                string payerMsg = "Вам поступил запрос на перевод от @" +
                                                    query->message->chat->username + ":\n" +
                                                    "Сумма: " + data.getAmount() + "\n";

                                if (!data.getMessage().empty()) {
                                    payerMsg += "Сообщение: " + data.getMessage() + "\n";
                                }

                                try {
                                    bot.getApi().sendMessage(payerChatId, payerMsg);
                                    successPayers.push_back(payer);
                                    interactedUsers.insert(payerChatId); // Обновляем список взаимодействий
                                } catch (...) {
                                    failedPayers.push_back(payer + " (ошибка отправки)");
                                }
                            } else {
                                noInteractionPayers.push_back(payer);
                            }
                        } else {
                            failedPayers.push_back(payer + " (не найден)");
                        }
                    }
                    string paymentLink =generatePaymentLink(data.getPayer(), data.getAmount(), data.getPaymentDetails());
                    bot.getApi().sendMessage(chatId, "Ссылка на перевод денежных средств: " + paymentLink);

                    // Формируем итоговое сообщение
                    if (!successPayers.empty()) {
                        responseMessage = "Запросы отправлены следующим пользователям:\n";
                        for (const string& user : successPayers) {
                            responseMessage += "- " + user + "\n";
                        }
                    }

                    if (!noInteractionPayers.empty()) {
                        if (!responseMessage.empty()) responseMessage += "\n";
                        responseMessage += "Не удалось отправить следующим пользователям (нет взаимодействия):\n";
                        for (const string& user : noInteractionPayers) {
                            responseMessage += "- " + user + "\n";
                        }
                    }

                    if (!failedPayers.empty()) {
                        if (!responseMessage.empty()) responseMessage += "\n";
                        responseMessage += "Ошибки при отправке:\n";
                        for (const string& user : failedPayers) {
                            responseMessage += "- " + user + "\n";
                        }
                    }

                    if (responseMessage.empty()) {
                        responseMessage = "Не удалось отправить запросы ни одному из указанных пользователей.";
                    }
                }

                bot.getApi().sendMessage(chatId, responseMessage);
                requestMoneyDataMap.erase(chatId);
                bot.getApi().deleteMessage(query->message->chat->id, query->message->messageId);
                print_functions(bot, query->message);
            }
        }
        else if (query->data == "change_send") {
            requestMoneyDataMap.erase(chatId);
            bot.getApi().sendMessage(chatId, "Отправка отменена. Введите заново имя плательщика/ов (например, @username):");
            requestMoneyDataMap[chatId] = RequestMoneyData();
            requestMoneyDataMap[chatId].setState(RequestMoneyData::WaitingForRecipient);
        }
        else if (query->data.find("confirm_phone:") == 0) {
            string phoneNumber = query->message->text.substr(query->message->text.rfind(" "));
            UserData &userData = users[query->message->chat->id];
            bot.getApi().answerCallbackQuery(query->id, "Номер телефона сохранён!");
            userData.setUserTag("@" + query->message->chat->username);
            string name = (query->message->chat->firstName) + " " + (query->message->chat->lastName);
            userData.setUserName(name);

            tg_id["@" + query->message->chat->username] = Metadata{chatId, phoneNumber};
            id_tg[chatId] = "@" + query->message->chat->username;
            bot.getApi().sendMessage(chatId, "Вы успешно зарегистрированы!");
            bot.getApi().deleteMessage(query->message->chat->id, query->message->messageId);
            print_functions(bot, query->message);
        }
        else if (query->data == "request_manual_phone") {
            bot.getApi().sendMessage(
                query->message->chat->id,
                "Пожалуйста, введите ваш номер телефона вручную:");
            bot.getApi().answerCallbackQuery(query->id, "Введите номер телефона вручную.");
        }
        bot.getApi().answerCallbackQuery(query->id);
    });

    bot.getEvents().onAnyMessage([&bot, &users](Message::Ptr message) {
        if (!message) return;
        int64_t chatId = message->chat->id;
        string text = message->text;

        UserData &userData = users[message->chat->id];

        // Остальная обработка сообщений (переводы, регистрация и т.д.)
        if (requestMoneyDataMap.find(chatId) != requestMoneyDataMap.end()) {
            RequestMoneyData &data = requestMoneyDataMap[chatId];
            if (data.getState() == RequestMoneyData::WaitingForRecipient) {
                if (text.empty() || text[0] != '@') {
                    bot.getApi().sendMessage(chatId, "Некорректный ввод. Введите имя плательщика/ов, начиная с '@'.");
                    return;
                }
                data.setPayer(text);
                data.setState(RequestMoneyData::WaitingForAmount);
                bot.getApi().sendMessage(chatId, "Введите сумму перевода:");
            }
            else if (data.getState() == RequestMoneyData::WaitingForAmount) {
                int count_dots =count(text.begin(), text.end(), '.');
                if(count_dots >1) {
                    bot.getApi().sendMessage(chatId, "Некорректная сумма! Повторите ввод суммы:");
                    return;
                }
                bool is_money_correct =true;
                auto rub =text.substr(0, text.find("."));
                if(rub.empty()) {
                    is_money_correct =false;
                }
                else{
                    if(count_dots ==1) {
                        auto kop =(text.substr(text.find(".") +1));
                        if(kop.size() >2||(kop.empty() &&count_dots ==1)) {
                            is_money_correct =false;
                        }
                    }
                    if(is_money_correct){
                        for(const auto&c: text) {
                            if(c !='.') {
                                if(c <'1'||c >'9') {
                                    is_money_correct =false;
                                    break;
                                }
                            }
                        }
                    }
                }
                if(!is_money_correct ||text.empty()) {
                    bot.getApi().sendMessage(chatId, "Некорректная сумма! Повторите ввод суммы:");
                    return;
                }
                data.setAmount(text);
                data.setState(RequestMoneyData::WaitingForMessage);
                InlineKeyboardMarkup::Ptr noMsgKeyboard(new InlineKeyboardMarkup);
                InlineKeyboardButton::Ptr noMsgBtn(new InlineKeyboardButton);
                noMsgBtn->text="Без сообщения";
                noMsgBtn->callbackData="no_message";
                noMsgKeyboard->inlineKeyboard.push_back({ noMsgBtn });
                bot.getApi().sendMessage(chatId, "Введите сообщение к запросу или нажмите кнопку «Без сообщения»:", nullptr, nullptr, noMsgKeyboard);
            }
            else if (data.getState() == RequestMoneyData::WaitingForMessage) {
                data.setMessage(text);
                if (tg_id.find(data.getPayer()) != tg_id.end()) {
                    data.setState(RequestMoneyData::WaitingForConfirmation);
                    string confirmationText = "Проверьте данные:\n\n" +
                        string("Плательщик: ") + data.getPayer() + "\n" +
                        "Сумма: " + data.getAmount();
                    if (!data.getMessage().empty()) {
                        confirmationText += "\nСообщение: " + data.getMessage();
                    }
                    auto confirmKeyboard = make_shared<InlineKeyboardMarkup>();
                    InlineKeyboardButton::Ptr confirmBtn(new InlineKeyboardButton);
                    confirmBtn->text = "Подтвердить";
                    confirmBtn->callbackData = "confirm_send";
                    InlineKeyboardButton::Ptr changeBtn(new InlineKeyboardButton);
                    changeBtn->text = "Изменить";
                    changeBtn->callbackData = "change_send";
                    confirmKeyboard->inlineKeyboard.push_back({ confirmBtn, changeBtn });
                    bot.getApi().sendMessage(chatId, confirmationText, nullptr, 0, confirmKeyboard);
                } else {
                    bot.getApi().sendMessage(chatId, "Пользователь " + data.getPayer() + " не найден.");
                    print_functions(bot, message);
                    requestMoneyDataMap.erase(chatId);
                }
            }
            else if (data.getState() == RequestMoneyData::WaitingForDetails) {
                data.setPaymentDetails(text);
                confirmPayment(bot, chatId);
            }
            return;
        }

        // Обработка регистрации
        if (!isRegistered(chatId)) {
            if (StringTools::startsWith(text, "/start")) {
                return;
            }

            if (message->contact != nullptr) {
                string phoneNumber = message->contact->phoneNumber;
                if (isValidPhoneNumberTGSend(phoneNumber)) {
                    userData.setPhoneNumber(phoneNumber);

                    auto inlineKeyboard = make_shared<InlineKeyboardMarkup>();
                    InlineKeyboardButton::Ptr yesButton(new InlineKeyboardButton);
                    yesButton->text = "Да";
                    yesButton->callbackData = "confirm_phone:" + userData.getPhoneNumber();

                    InlineKeyboardButton::Ptr noButton(new InlineKeyboardButton);
                    noButton->text = "Нет";
                    noButton->callbackData = "request_manual_phone";

                    vector<InlineKeyboardButton::Ptr> row = { yesButton, noButton };
                    inlineKeyboard->inlineKeyboard.push_back(row);

                    bot.getApi().sendMessage(
                        message->chat->id,
                        "Ваш счёт привязан к этому номеру телефона?: +" +
                            userData.getPhoneNumber(),
                            nullptr, 0, inlineKeyboard);

                    userData.setUserTag("@" + message->from->username);
                    string name = (message->chat->firstName) + " " + (message->chat->lastName);
                    userData.setUserName(name);
                }
                else {
                    bot.getApi().sendMessage(message->chat->id,
                        "Номер телефона недействителен. Пожалуйста, "
                        "введите корректный номер телефона.");
                }
            }
            else if (message->text == "Да") {
                tg_id[text.substr(0, text.find(" "))] = Metadata{ chatId, text.substr(text.find(" ") + 1 )};
                id_tg[chatId] = text.substr(0, text.find(" "));
                bot.getApi().sendMessage(chatId, "Вы успешно зарегистрированы!");
                bot.getApi().deleteMessage(message->chat->id, message->messageId);
                print_functions(bot, message);
            }
            else if (message->text == "Нет") {
                bot.getApi().sendMessage(message->chat->id,
                    "Пожалуйста, введите новый номер телефона:");
                    bot.getApi().deleteMessage(message->chat->id, message->messageId);
            }
            else {
                string phoneNumber = message->text;
                if (isValidPhoneNumber(phoneNumber)) {
                    userData.setPhoneNumber(phoneNumber);
                    auto inlineKeyboard = make_shared<InlineKeyboardMarkup>();
                    InlineKeyboardButton::Ptr yesButton(new InlineKeyboardButton);
                    yesButton->text = "Да";
                    yesButton->callbackData = "confirm_phone:" + userData.getPhoneNumber();

                    InlineKeyboardButton::Ptr noButton(new InlineKeyboardButton);
                    noButton->text = "Нет";
                    noButton->callbackData = "request_manual_phone";

                    vector<InlineKeyboardButton::Ptr> row = { yesButton, noButton };
                    inlineKeyboard->inlineKeyboard.push_back(row);

                    bot.getApi().sendMessage(
                        message->chat->id,
                        "Ваш счёт привязан к этому номеру телефона(2)?: " +
                            userData.getPhoneNumber(),
                            nullptr, 0, inlineKeyboard);
                    userData.setUserTag("@" + message->from->username);
                    string name = (message->chat->firstName) + " " + (message->chat->lastName);
                    userData.setUserName(name);
                }
                else {
                    bot.getApi().sendMessage(message->chat->id,
                        "Номер телефона недействителен(2). Пожалуйста, "
                        "введите корректный номер телефона.");
                }
            }
        }
    });

    try {
        printf("Bot username: %s\n", bot.getApi().getMe()->username.c_str());
        TgLongPoll longPoll(bot);
        while (true) {
            printf("Long poll started\n");
            longPoll.start();
        }
    } catch (TgException& e) {
        printf("error: %s\n", e.what());
    }

    return 0;
}
