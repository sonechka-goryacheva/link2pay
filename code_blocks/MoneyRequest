class RequestMoneyData {
public:
    enum State {
        None,
        WaitingForRecipient,
        WaitingForAmount,
        WaitingForMessage,
        WaitingForConfirmation,
        WaitingForDetails,
        Completed
    };

    RequestMoneyData() : payer(""), state(None) {}

    string getPayer() const { return payer; }
    string getAmount() const { return amount; }
    string getMessage() const { return message; }
    string getPaymentDetails() const { return paymentDetails; }
    State getState() const { return state; }

    void setPayer(const string& r) { payer = r; }
    void setAmount(const string& a) { amount = a; }
    void setMessage(const string& m) { message = m; }
    void setState(State s) { state = s; }
    void setPaymentDetails(const string& p) { paymentDetails = p; }

private:
    string payer;
    string amount;
    string message;
    string paymentDetails;
    State state;
};

class Metadata {
private:
    int64_t chat_id;
    string phone_number;

public:
    Metadata() = default;
    Metadata(int64_t cid, const string& pn) : chat_id(cid), phone_number(pn) {}

    int64_t getChatId() const { return chat_id; }
    string getPhoneNumber() const { return phone_number; }

    bool operator<(const Metadata& other) const {
        return tie(chat_id, phone_number) < tie(other.chat_id, other.phone_number);
    }
};

