struct metadata {
    int64_t chat_id;
    string phone_number;
    bool operator<(const metadata& data) const {
        if (chat_id != data.chat_id) {
            return chat_id < data.chat_id;
        }
        else {
            return phone_number < data.phone_number;
        }
    }
};

