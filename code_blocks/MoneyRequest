class LinkRequest {
private:
    double transferAmount;
    string message;
    string recipientRequisites;

public:
    LinkRequest() : transferAmount(0.0), message("noMessage"), recipientRequisites("default_requisites") {}

    double getTransferAmount() const { return transferAmount; }
    string getMessage() const { return message; }
    string getSenderRequisites() const { return recipientRequisites; }

    void setTransferAmount(double newTransferAmount) { transferAmount = newTransferAmount; }
    void setMessage(const string& newMessage) { message = newMessage; }
    void setSenderRequisites(const string& newRequisites) { recipientRequisites = newRequisites; }
};

