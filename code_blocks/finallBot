            return;
          }

          // Проверяем регистрацию через базу данных
          if (db.isUserRegisteredByUsername(username.substr(1))) { // убираем @
            auto chatIdOpt = db.getChatIdByUsername(username.substr(1));
            if (chatIdOpt) {
              string payerMsg = "Вам поступил запрос на перевод от @" +
                                query->message->chat->username + ":\n" +
                                "Сумма: " + data.getAmount() + "\n";

              if (!data.getMessage().empty()) {
                payerMsg += "Сообщение: " + data.getMessage() + "\n";
                payerMsg += "\nСсылка для перевода: " + paymentLink;
              }

              try {
                bot.getApi().sendMessage(*chatIdOpt, payerMsg);
                responseMessage =
                    "Запрос на перевод отправлен пользователю " + username;
              } catch (const exception &e) {
                responseMessage =
                    "Ошибка при отправке запроса: " + string(e.what());
              }
            } else {
              responseMessage =
                  "Не удалось получить chat_id пользователя " + username;
            }
          } else {
            responseMessage = "Пользователь " + username +
                              " не зарегистрирован в системе.\n"
                              "Вы можете отправить ссылку на платёж: " +
                              paymentLink;
          }
        } else {
          // Обработка нескольких получателей
          vector<string> successPayers;
          vector<string> failedPayers;
          vector<string> unregisteredPayers;
          bool anyUnregistered = false;

          for (const string &username : usernames) {
            if (db.isUserRegisteredByUsername(username.substr(1))) {
              auto chatIdOpt = db.getChatIdByUsername(username.substr(1));
              if (chatIdOpt) {
                string payerMsg = "Вам поступил запрос на перевод от @" +
                                  query->message->chat->username + ":\n" +
                                  "Сумма: " + data.getAmount() + "\n";

                if (!data.getMessage().empty()) {
                  payerMsg += "Сообщение: " + data.getMessage() + "\n";
                  payerMsg += "\nСсылка для перевода: " + paymentLink;
                }

                try {
                  bot.getApi().sendMessage(*chatIdOpt, payerMsg);
                  successPayers.push_back(username);
                } catch (...) {
                  failedPayers.push_back(username + " (ошибка отправки)");
                }
              } else {
                failedPayers.push_back(username +
                                       " (не удалось получить chat_id)");
              }
            } else {
              unregisteredPayers.push_back(username + " (не зарегистрирован)");
              anyUnregistered = true;
            }
          }

          // Формируем итоговое сообщение
          if (!successPayers.empty()) {
            responseMessage = "Запросы отправлены следующим пользователям:\n";
            for (const string &user : successPayers) {
              responseMessage += "- " + user + "\n";
            }
          }

          if (!unregisteredPayers.empty()) {
            if (!responseMessage.empty())
              responseMessage += "\n";
            responseMessage += "Следующие пользователи не зарегистрированы:\n";
            for (const string &user : unregisteredPayers) {
              responseMessage += "- " + user + "\n";
            }
          }

          if (!failedPayers.empty()) {
            if (!responseMessage.empty())
              responseMessage += "\n";
            responseMessage += "Ошибки при отправке:\n";
            for (const string &user : failedPayers) {
              responseMessage += "- " + user + "\n";
            }
          }
          if (responseMessage.empty()) {
            responseMessage = "Не удалось отправить запросы ни одному из "
                              "указанных пользователей.";
          }

          // Если есть незарегистрированные - добавляем ссылку
          if (anyUnregistered) {
            responseMessage += "\nДля незарегистрированных пользователей вы "
                               "можете отправить ссылку на платёж: " +
                               paymentLink;
          }
          bot.getApi().sendMessage(chatId, responseMessage);
          requestMoneyDataMap.erase(chatId);
          bot.getApi().deleteMessage(query->message->chat->id,
                                     query->message->messageId);
          print_functions(bot, query->message);
        }
      }
    } else if (query->data == "change_send") {
      requestMoneyDataMap.erase(chatId);
      bot.getApi().sendMessage(chatId, "Отправка отменена. Введите заново имя "
                                       "плательщика/ов (например, @username):");
      requestMoneyDataMap[chatId] = RequestMoneyData();
      requestMoneyDataMap[chatId].setState(
          RequestMoneyData::WaitingForRecipient);
    } else if (query->data.find("confirm_phone:") == 0) {
      if (users.find(query->message->chat->id) == users.end()) {
        bot.getApi().answerCallbackQuery(query->id,
                                         "Ошибка: данные не найдены!");
        return;
      }

      UserData &userData = users[query->message->chat->id];
      if (userData.getPhoneNumber().empty()) {
        bot.getApi().answerCallbackQuery(query->id, "Ошибка: номер не указан!");
        return;
      }

      try {
        db.saveUser(userData);
        users.erase(query->message->chat->id);
        bot.getApi().editMessageText(
            "✅ Регистрация завершена!\nВаши данные сохранены.",
            query->message->chat->id, query->message->messageId);
      } catch (const exception &e) {
        cerr << "Error saving user: " << e.what() << endl;
      }
      print_functions(bot, query->message);
    } else if (query->data == "request_manual_phone") {
      bot.getApi().sendMessage(
          query->message->chat->id,
          "Пожалуйста, введите ваш номер телефона вручную:");
      bot.getApi().answerCallbackQuery(query->id,
                                       "Введите номер телефона вручную.");
    }
    bot.getApi().answerCallbackQuery(query->id);
  });

  bot.getEvents().onAnyMessage([&bot, &users, &db](Message::Ptr message) {
    if (!message)
      return;
    int64_t chatId = message->chat->id;
    string text = message->text;
    UserData &userData = users[message->chat->id];
    userData.setUserId(message->chat->id);

    if (sendMoneyDataMap.find(chatId) != sendMoneyDataMap.end()) {
      SendMoneyData &data = sendMoneyDataMap[chatId];
      if (data.getState() == SendMoneyData::WaitingForRecipient) {
        if (text.empty() || text[0] != '@') {
          bot.getApi().sendMessage(
              chatId,
              "Некорректный ввод. Введите имя получателя, начиная с '@'.");
          return;
        }
        data.setRecipient(text);
        data.setState(SendMoneyData::WaitingForAmount);
        bot.getApi().sendMessage(chatId, "Введите сумму перевода:");
      } else if (data.getState() == SendMoneyData::WaitingForAmount) {
        int count_dots = count(text.begin(), text.end(), dot_char);
        if (count_dots > 1) {
          bot.getApi().sendMessage(chatId,
                                   "Некорректная сумма! Повторите ввод суммы:");
          return;
        }
        bool is_money_correct = true;
        auto rub = text.substr(0, text.find(dot_string));
        if (rub.empty()) {
          is_money_correct = false;
        } else {
          if (count_dots == 1) {
            auto kop = (text.substr(text.find(dot_string) + 1));
            if (kop.size() > 2 || (kop.empty() && count_dots == 1)) {
              is_money_correct = false;
            }
          }
          if (is_money_correct) {
            for (const auto &c : text) {
              if (c != dot_char) {
                if (c < '0' || c > '9') {
                  is_money_correct = false;
                  break;
                }
              }
            }
          }
        }
        if (!is_money_correct || text.empty()) {
          bot.getApi().sendMessage(chatId,
                                   "Некорректная сумма! Повторите ввод суммы:");
          return;
        }
        data.setAmount(text);
        data.setState(SendMoneyData::WaitingForMessage);
        InlineKeyboardMarkup::Ptr noMsgKeyboard(new InlineKeyboardMarkup);
        InlineKeyboardButton::Ptr noMsgBtn(new InlineKeyboardButton);
        noMsgBtn->text = "Без сообщения";
        noMsgBtn->callbackData = "no_message_send";
        noMsgKeyboard->inlineKeyboard.push_back({noMsgBtn});
        bot.getApi().sendMessage(
            chatId,
            "Введите сообщение к запросу или нажмите кнопку «Без сообщения»:",
            nullptr, nullptr, noMsgKeyboard);
      } else if (data.getState() == SendMoneyData::WaitingForMessage) {
        data.setMessage(text);
        // Проверяем наличие получателя в системе
        SendMoneyData &data = sendMoneyDataMap[chatId];
        // Если пользователь получателя зарегистрирован в системе
        string username = data.getRecipient();
        if (db.isUserRegisteredByUsername(username.substr(1))) {
          data.setState(SendMoneyData::WaitingForConfirmation);
          string confirmationText =
              "Проверьте данные:\n\n" + string("Получатель: ") +
              data.getRecipient() + "\n" + "Сумма: " + data.getAmount();
          if (!data.getMessage().empty()) {
            confirmationText += "\nСообщение: " + data.getMessage();
          }
          InlineKeyboardMarkup::Ptr confirmKeyboard(new InlineKeyboardMarkup);
          InlineKeyboardButton::Ptr confirmBtn(new InlineKeyboardButton);
          confirmBtn->text = "Подтвердить";
          confirmBtn->callbackData = "confirm_send_send";
          InlineKeyboardButton::Ptr changeBtn(new InlineKeyboardButton);
          changeBtn->text = "Изменить";
          changeBtn->callbackData = "change_send_send";
          confirmKeyboard->inlineKeyboard.push_back({confirmBtn, changeBtn});
          bot.getApi().sendMessage(chatId, confirmationText, nullptr, nullptr,
                                   confirmKeyboard);
        } else {
          bot.getApi().sendMessage(
              chatId, "Пользователь " + data.getRecipient() + " не найден.");
          print_functions(bot, message);
          sendMoneyDataMap.erase(chatId);
        }
      } else if (data.getState() == SendMoneyData::WaitingForDetails) {
        data.setPaymentDetails(text);
        confirmPaymentSend(bot, chatId);
      }
      return;
    }
    // Остальная обработка сообщений (переводы, регистрация и т.д.)
    if (requestMoneyDataMap.find(chatId) != requestMoneyDataMap.end()) {
      RequestMoneyData &data = requestMoneyDataMap[chatId];
      if (data.getState() == RequestMoneyData::WaitingForRecipient) {
        if (text.empty() || text[0] != '@') {
          bot.getApi().sendMessage(chatId, "Некорректный ввод. Введите имя "
                                           "плательщика/ов, начиная с '@'.");
          return;
        }
        data.setPayer(text);
        data.setState(RequestMoneyData::WaitingForAmount);
        bot.getApi().sendMessage(chatId, "Введите сумму перевода:");
      } else if (data.getState() == RequestMoneyData::WaitingForAmount) {
        int count_dots = count(text.begin(), text.end(), '.');
        if (count_dots > 1) {
          bot.getApi().sendMessage(chatId,
                                   "Некорректная сумма! Повторите ввод суммы:");
          return;
        }
        bool is_money_correct = true;
        auto rub = text.substr(0, text.find("."));
        if (rub.empty()) {
          is_money_correct = false;
        } else {
          if (count_dots == 1) {
            auto kop = (text.substr(text.find(".") + 1));
            if (kop.size() > 2 || (kop.empty() && count_dots == 1)) {
              is_money_correct = false;
            }
          }
          if (is_money_correct) {
            for (const auto &c : text) {
              if (c != '.') {
                if ((c < '0' || c > '9') || (c == '0' && rub.size() == 1)) {
                  is_money_correct = false;
                  break;
                }
              }
            }
          }
        }
        if (!is_money_correct || text.empty()) {
          bot.getApi().sendMessage(chatId,
                                   "Некорректная сумма! Повторите ввод суммы:");
          return;
        }
        data.setAmount(text);
        data.setState(RequestMoneyData::WaitingForMessage);
        InlineKeyboardMarkup::Ptr noMsgKeyboard(new InlineKeyboardMarkup);
        InlineKeyboardButton::Ptr noMsgBtn(new InlineKeyboardButton);
        noMsgBtn->text = "Без сообщения";
        noMsgBtn->callbackData = "no_message";
        noMsgKeyboard->inlineKeyboard.push_back({noMsgBtn});
        bot.getApi().sendMessage(
            chatId,
            "Введите сообщение к запросу или нажмите кнопку «Без сообщения»:",
            nullptr, nullptr, noMsgKeyboard);
      } else if (data.getState() == RequestMoneyData::WaitingForMessage) {
        data.setMessage(text);
        data.setState(RequestMoneyData::WaitingForConfirmation);
        string confirmationText = "Проверьте данные:\n\n" +
                                  string("Плательщик: ") + data.getPayer() +
                                  "\n" + "Сумма: " + data.getAmount();

        confirmationText += "\nСообщение: " + data.getMessage();

        auto confirmKeyboard = make_shared<InlineKeyboardMarkup>();
        InlineKeyboardButton::Ptr confirmBtn(new InlineKeyboardButton);
        confirmBtn->text = "Подтвердить";
        confirmBtn->callbackData = "confirm_send";
        InlineKeyboardButton::Ptr changeBtn(new InlineKeyboardButton);
        changeBtn->text = "Изменить";
        changeBtn->callbackData = "change_send";
        confirmKeyboard->inlineKeyboard.push_back({confirmBtn, changeBtn});
        bot.getApi().sendMessage(chatId, confirmationText, nullptr, 0,
                                 confirmKeyboard);

      } else if (data.getState() == RequestMoneyData::WaitingForDetails) {
        data.setPaymentDetails(text);
        confirmPayment(bot, chatId);
      }
      return;
    }

    // Обработка регистрации
    if (!isRegistered(chatId)) {
      if (StringTools::startsWith(text, "/start")) {
        return;
      }

      if (message->contact != nullptr) {
        string phoneNumber = message->contact->phoneNumber;
        if (isValidPhoneNumberTGSend(phoneNumber)) {
          userData.setPhoneNumber(phoneNumber);

          auto inlineKeyboard = make_shared<InlineKeyboardMarkup>();
          InlineKeyboardButton::Ptr yesButton(new InlineKeyboardButton);
          yesButton->text = "Да";
          yesButton->callbackData =
              "confirm_phone:" + userData.getPhoneNumber();

          InlineKeyboardButton::Ptr noButton(new InlineKeyboardButton);
          noButton->text = "Нет";
          noButton->callbackData = "request_manual_phone";

          vector<InlineKeyboardButton::Ptr> row = {yesButton, noButton};
          inlineKeyboard->inlineKeyboard.push_back(row);

          bot.getApi().sendMessage(
              message->chat->id,
              "Ваш счёт привязан к этому номеру телефона?: +" +
                  userData.getPhoneNumber(),
              nullptr, 0, inlineKeyboard);

          userData.setUserTag("@" + message->from->username);
          string name =
              (message->chat->firstName) + " " + (message->chat->lastName);
          userData.setUserName(name);
        } else {
          bot.getApi().sendMessage(message->chat->id,
                                   "Номер телефона недействителен. Пожалуйста, "
                                   "введите корректный номер телефона.");
        }
      } else if (message->text == "Да") {
        tg_id[text.substr(0, text.find(" "))] =
            Metadata{chatId, text.substr(text.find(" ") + 1)};
        id_tg[chatId] = text.substr(0, text.find(" "));
        bot.getApi().sendMessage(chatId, "Вы успешно зарегистрированы!");
        bot.getApi().deleteMessage(message->chat->id, message->messageId);
        print_functions(bot, message);
      } else if (message->text == "Нет") {
        bot.getApi().sendMessage(message->chat->id,
                                 "Пожалуйста, введите новый номер телефона:");
        bot.getApi().deleteMessage(message->chat->id, message->messageId);
      } else {
        string phoneNumber = message->text;
        if (isValidPhoneNumber(phoneNumber)) {
          userData.setPhoneNumber(phoneNumber);
          auto inlineKeyboard = make_shared<InlineKeyboardMarkup>();
          InlineKeyboardButton::Ptr yesButton(new InlineKeyboardButton);
          yesButton->text = "Да";
          yesButton->callbackData =
              "confirm_phone:" + userData.getPhoneNumber();

          InlineKeyboardButton::Ptr noButton(new InlineKeyboardButton);
          noButton->text = "Нет";
          noButton->callbackData = "request_manual_phone";

          vector<InlineKeyboardButton::Ptr> row = {yesButton, noButton};
          inlineKeyboard->inlineKeyboard.push_back(row);

          bot.getApi().sendMessage(
              message->chat->id,
              "Ваш счёт привязан к этому номеру телефона?: " +
                  userData.getPhoneNumber(),
              nullptr, 0, inlineKeyboard);
          userData.setUserTag("@" + message->from->username);
          string name =
              (message->chat->firstName) + " " + (message->chat->lastName);
          userData.setUserName(name);
        } else {
          bot.getApi().sendMessage(message->chat->id,
                                   "Номер телефона недействителен. Пожалуйста, "
                                   "введите корректный номер телефона.");
        }
      }
    }
    // Обновление информации о пользователе
    userData.setUserName(message->chat->firstName + " " +
                         message->chat->lastName);
    userData.setUserTag(message->from->username);
  });

  try {
    printf("Bot username: %s\n", bot.getApi().getMe()->username.c_str());
    TgLongPoll longPoll(bot);
    while (true) {
      printf("Long poll started\n");
      longPoll.start();
    }
  } catch (TgException &e) {
    printf("error: %s\n", e.what());
  }

  return 0;
}
