class Database {
private:
  std::string conn_string;

public:
Database(const std::string &host, const std::string &dbname,
  const std::string &user, const std::string &password)
: conn_string("host=" + host + " port=54321 dbname=" + dbname + " user=" + user +
         " password=" + password) {}
  // Проверка регистрации пользователя
  bool isUserRegistered(int64_t chat_id) {
    try {
      pqxx::connection conn(conn_string);
      pqxx::work txn(conn);
      pqxx::result res = txn.exec("SELECT 1 FROM users WHERE chat_id = " +
                                  std::to_string(chat_id));
      return !res.empty();
    } catch (const std::exception &e) {
      std::cerr << "Database error: " << e.what() << std::endl;
      return false;
    }
  }

  // Получение данных пользователя
  std::optional<UserData> getUserData(int64_t chat_id) {
    try {
      pqxx::connection conn(conn_string);
      pqxx::work txn(conn);
      pqxx::result res =
          txn.exec("SELECT username, name, phone FROM users WHERE chat_id = " +
                   std::to_string(chat_id));

      if (!res.empty()) {
        UserData user;
        user.setUserId(chat_id);
        user.setUserTag(res[0]["username"].as<std::string>());
        user.setUserName(res[0]["name"].as<std::string>());
        user.setPhoneNumber(res[0]["phone"].as<std::string>());
        return user;
      }
    } catch (const std::exception &e) {
      std::cerr << "Database error: " << e.what() << std::endl;
    }
    return std::nullopt;
  }

  // Сохранение пользователя
  void saveUser(const UserData &user) {
    try {
      pqxx::connection conn(conn_string);
      pqxx::work txn(conn);

      std::string query = "INSERT INTO users (chat_id, username, name, phone) "
                          "VALUES (" +
                          std::to_string(user.getUserId()) + ", " +
                          txn.quote(user.getUserTag()) + ", " +
                          txn.quote(user.getUserName()) + ", " +
                          txn.quote(user.getPhoneNumber()) +
                          ") "
                          "ON CONFLICT (chat_id) DO UPDATE SET "
                          "username = EXCLUDED.username, "
                          "name = EXCLUDED.name, "
                          "phone = EXCLUDED.phone";

      txn.exec(query);
      txn.commit();
    } catch (const std::exception &e) {
      throw std::runtime_error("Failed to save user: " + std::string(e.what()));
    }
  }
  // Проверка регистрации по username (@nickname)
  bool isUserRegisteredByUsername(const std::string &username) {
    try {
      pqxx::connection conn(conn_string);
      pqxx::work txn(conn);
      pqxx::result res = txn.exec("SELECT 1 FROM users WHERE username = " +
                                  txn.quote(username));
      return !res.empty();
    } catch (const std::exception &e) {
      std::cerr << "Database error: " << e.what() << std::endl;
      return false;
    }
  }

  // Получение chat_id по username
  std::optional<int64_t> getChatIdByUsername(const std::string &username) {
    try {
      pqxx::connection conn(conn_string);
      pqxx::work txn(conn);
      pqxx::result res = txn.exec(
          "SELECT chat_id FROM users WHERE username = " + txn.quote(username));
      if (!res.empty()) {
        return res[0]["chat_id"].as<int64_t>();
      }
    } catch (...) {
      std::cerr << "Error getting chat_id" << std::endl;
    }
    return std::nullopt;
  }
};
