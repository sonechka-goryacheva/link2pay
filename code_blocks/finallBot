string urlEncode(const string &value) {
  ostringstream escaped;
  escaped.fill('0');
  escaped << hex;
  for (char c : value) {
    if (isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '_' ||
        c == '.' || c == '~') {
      escaped << c;
    } else {
      escaped << '%' << setw(2) << int((unsigned char)c);
    }
  }
  return escaped.str();
}

string generatePaymentLink(const string &recipient, const string &amount,
                           const string &paymentDetails) {
  // Базовый URL вашего платежного шлюза
  string baseUrl = "https://your-payment-gateway.com/create_payment";
  string link = baseUrl + "?recipient=" + urlEncode(recipient) +
                "&amount=" + urlEncode(amount) +
                "&details=" + urlEncode(paymentDetails);
  return link;
}

void confirm_send_function(int64_t chatId, const Bot &bot,
                           CallbackQuery::Ptr query) {
  if (sendMoneyDataMap.find(chatId) != sendMoneyDataMap.end()) {
    SendMoneyData &data = sendMoneyDataMap[chatId];
    // Если пользователь получателя зарегистрирован в системе

    if (tg_id.find(data.getRecipient()) != tg_id.end()) {
      // Создаем объект запроса на перевод и заполняем его данными
      TransferRequest transferSend;
      transferSend.setPayerTag(id_tg[chatId]);
      transferSend.setRecipientTag(data.getRecipient());
      LinkRequest lr;
      // Преобразуем сумму в double (при необходимости, можно добавить обработку
      // ошибок)
      lr.setTransferAmount(stod(data.getAmount()));
      lr.setMessage(data.getMessage());
      lr.setSenderRequisites(data.getPaymentDetails());
      transferSend.setLinkRequest(lr);

      // Формируем ссылку на оплату
      string paymentLink = generatePaymentLink(
          data.getRecipient(), data.getAmount(), data.getPaymentDetails());
      bot.getApi().sendMessage(
          chatId, "Данные подтверждены! Ссылка на перевод денежных средств: " +
                      paymentLink);
      bot.getApi().sendMessage(chatId, "Скоро эта ссылка станет рабочей!");

      print_functions(bot, query->message);

      // Отправляем уведомление получателю
      string sendMsg = "Вам поступил перевод денежных средств на сумму " +
                       data.getAmount() + " от " + id_tg[chatId];
      if (!data.getMessage().empty()) {
        sendMsg += "\nСообщение: " + data.getMessage();
      }
      bot.getApi().sendMessage(tg_id[data.getRecipient()].getChatId(), sendMsg);
      bot.getApi().deleteMessage(query->message->chat->id,
                                 query->message->messageId);
    } else {
      bot.getApi().sendMessage(chatId, "Пользователь " + data.getRecipient() +
                                           " не найден.");
      print_functions(bot, query->message);
      bot.getApi().deleteMessage(query->message->chat->id,
                                 query->message->messageId);
    }
  }
}

vector<string> extractUsernames(const string &text) {
  vector<string> usernames;
  size_t pos = 0;
  while (pos < text.length()) {
    pos = text.find('@', pos);
    if (pos == string::npos)
      break;

    size_t end = text.find_first_of(" ,.!?\n", pos + 1);
    if (end == string::npos)
      end = text.length();

    string username = text.substr(pos, end - pos);
    if (!username.empty()) {
      usernames.push_back(username);
    }
    pos = end;
  }
  return usernames;
}
